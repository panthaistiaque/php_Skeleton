#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
APP_NAME="Skeleton App"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost/php_Skeleton"
APP_TIMEZONE="Asia/Dhaka"
APP_KEY=base64:I2N2NWo3ODloYjRrOTNtM2Y4eA==

#--------------------------------------------------------------------------
# Database (MySQL by default - PDO)
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skeleton_app
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

#--------------------------------------------------------------------------
# Session
#--------------------------------------------------------------------------
SESSION_NAME=SKEL_APP
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

#--------------------------------------------------------------------------
# SMTP (mail) - leave SMTP_ENABLED=false to log emails to storage/mails
#--------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@example.test
SMTP_FROM_NAME="Skeleton App"

#--------------------------------------------------------------------------
# Backup (mysqldump path - on XAMPP Windows: C:/xampp/mysql/bin/mysqldump.exe)
#--------------------------------------------------------------------------
MYSQLDUMP_PATH=""