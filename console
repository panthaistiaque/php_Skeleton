<?php

declare(strict_types=1);

/**
 * Skeleton App CLI entry point.
 *
 * Usage:
 *   php console migrate
 *   php console seed
 *   php console admin:create --email=admin@example.com --password=secret --name=Administrator
 *   php console backup
 *   php console key:generate
 *   php console fresh
 */

use App\Console\Kernel;

define('ROOT_PATH', dirname(__FILE__));
define('APP_PATH', ROOT_PATH . '/app');
define('VIEW_PATH', APP_PATH . '/Views');
define('CONFIG_PATH', ROOT_PATH . '/config');
define('DATABASE_PATH', ROOT_PATH . '/database');
define('STORAGE_PATH', ROOT_PATH . '/storage');
define('PUBLIC_PATH', ROOT_PATH . '/public');

$autoload = ROOT_PATH . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Composer autoloader missing. Run: composer install\n");
    exit(1);
}
require $autoload;

\App\Core\Env::load(ROOT_PATH . '/.env');
require APP_PATH . '/Helpers/functions.php';
\App\Core\Config::set(require CONFIG_PATH . '/config.php');
date_default_timezone_set((string)\App\Core\Config::get('default_settings.general.timezone', 'UTC'));

exit(Kernel::run($argv));